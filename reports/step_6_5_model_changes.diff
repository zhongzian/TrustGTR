+            width = regime_distance.shape[-1]
+            safe = positions.clamp(0, width - 1)
+            selected_regime = regime_distance.detach().gather(-1, safe)
+            disjoint = candidate_mask.unsqueeze(1).expand_as(regime_distance).gather(-1, safe)
