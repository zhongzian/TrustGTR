+                    'selected_candidate_weights')
+        if any(name not in state for name in required):
+            raise RuntimeError('Retrieval-hard contrast requires the training retrieval collector')
+        with torch.no_grad():
+            positions, key_distance, weights = (state[name].detach() for name in required)
+            if positions.shape != key_distance.shape or positions.shape != weights.shape:
+                raise ValueError('Mismatched retrieval selection shapes')
+            if positions.shape[:2] != regime_distance.shape[:2]:
+                raise ValueError('Retrieval selection does not match contrastive anchors')
+            if not positions.shape[-1]:
